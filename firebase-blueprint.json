{
  "entities": {
    "Order": {
      "title": "Print Order",
      "description": "Customer print order details stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "productTitle": { "type": "string" },
        "quantity": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "phone", "productTitle", "quantity", "totalAmount", "status", "createdAt"]
    },
    "Inquiry": {
      "title": "Customer Inquiry",
      "description": "Bulk quote or contact inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "message", "createdAt"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders collection"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Customer inquiries collection"
    }
  }
}
